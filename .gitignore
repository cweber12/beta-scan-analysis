.venv/
__pycache__/
*.pyc
*.pt
downloads/

# Machine-local agent permission overrides. The shared, reviewed rules live in
# the tracked .claude/settings.json; anything one-off stays untracked here.
.claude/settings.local.json

# Derived analysis outputs (report.html + features CSVs).
reports/

# Video binaries live inside the analysis bundle, but stay out of git; the
# metadata.json / final_frame.png / detections/ record is still tracked.
analysis/**/*.mp4
analysis/**/*.mov
analysis/**/*.mkv
analysis/**/*.webm
analysis/**/*.avi

# Flagged-frame crop thumbnails (issue #44): derived from the gitignored video
# binary, referenced by path in the eval record — the JSON record stays tracked,
# the PNGs do not (same rule as the video binaries above).
analysis/**/crops/

# MediaPipe Pose Landmarker bundles (ADR 0012). The .task binaries are 6-30 MB and are
# fetched by scripts/fetch_mediapipe_models.py; models/mediapipe.lock.json is the tracked
# record of which weights every experimental arm was defined against. Same rule as the
# video binaries and *.pt weights above.
models/mediapipe/*.task
